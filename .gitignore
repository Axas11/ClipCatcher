# ============================================================
# .gitignore — ClipCatcher (TFG)
# Francisco Jose Rodriguez Guerra · 2º DAW · 2025-2026
# ============================================================
# Archivos y carpetas que NO se suben al repo, por tamaño,
# seguridad o porque no aportan al proceso de evaluación.

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Entornos virtuales
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribuciones / packaging
build/
dist/
*.egg
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Testing y cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Linters / type checkers
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ------------------------------------------------------------
# PyInstaller (versión "AlgoritmoX - Local-EXE")
# ------------------------------------------------------------
# build/ y dist/ ya estan cubiertos arriba.
# Los .spec SI se mantienen en el repo: son configuracion.
*.manifest
*.exe
*.dll
*.dylib

# ------------------------------------------------------------
# Modelos de IA y archivos pesados
# ------------------------------------------------------------
# Por defecto se ignoran TODOS los formatos de modelo,
# y abajo se hacen excepciones explicitas para los que
# son imprescindibles para que el proyecto funcione.
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.joblib
*.bin
*.safetensors
*.ckpt

# Modelos descargados de Whisper (75 MB - 1.5 GB)
whisper_models/
.cache/whisper/

# >>> EXCEPCIONES: modelos necesarios para la evaluacion
!model/kill_detector.pt
!models/kill_detector.pt

# ------------------------------------------------------------
# Video, audio y media (archivos de prueba y de usuario)
# ------------------------------------------------------------
*.mp4
*.avi
*.mkv
*.mov
*.webm
*.flv
*.wmv
*.m4v
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac

# Carpetas de trabajo en runtime
videos/
clips/
uploads/
outputs/
processed/
data/
temp/
tmp/
media/

# ------------------------------------------------------------
# Bases de datos
# ------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sqlite-journal

# Datos persistidos de MySQL / MariaDB (volumenes locales)
mysql_data/
db_data/
mariadb_data/

# Volumenes de Docker bind-mounted
volumes/
redis_data/

# ------------------------------------------------------------
# Variables de entorno y secretos (CRITICO)
# ------------------------------------------------------------
.env
.env.local
.env.*.local
.env.production
.env.development
*.secret
secrets/
secrets.json

# Credenciales de Google OAuth
credentials.json
client_secret*.json

# Plantillas SI deben subirse (sin valores reales)
!.env.example
!.env.sample

# Claves y certificados
*.pem
*.key
*.cert
*.crt
*.p12

# ------------------------------------------------------------
# Frontend / Node (cuando se aplique)
# ------------------------------------------------------------
node_modules/
.npm
.yarn/
.pnpm-store/
yarn-error.log
.next/
.nuxt/
.parcel-cache/
.cache/

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------
# Override local de docker-compose (configuracion de cada uno)
docker-compose.override.yml
docker-compose.override.yaml

# ------------------------------------------------------------
# IDEs y editores
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ------------------------------------------------------------
# Sistemas operativos
# ------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ------------------------------------------------------------
# Backups y archivos temporales
# ------------------------------------------------------------
*.bak
*.backup
*.old
*.tmp
*.orig
*.rej

# ------------------------------------------------------------
# Archivos comprimidos
# ------------------------------------------------------------
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# ------------------------------------------------------------
# Documentacion generada
# ------------------------------------------------------------
docs/_build/
docs/build/
site/

# ------------------------------------------------------------
# Vite / extras del frontend remoto
# ------------------------------------------------------------
dist-ssr
*.local
lerna-debug.log*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
