# Plantilla de variables de entorno del backend de ClipCatcher.
# Copia este archivo a `backend/.env` y rellena los valores reales.
# El archivo `.env` esta gitignorado: NUNCA subir secretos al repositorio.

# Clave general de la aplicacion (cookies firmadas, etc.). Cambiar siempre.
APP_SECRET_KEY=change-me-a-long-random-string

# Conexion a la base de datos. SQLite local para el MVP.
# La carpeta `data/` se crea automaticamente al arrancar.
DATABASE_URL=sqlite:///./data/clipcatcher.db

# Configuracion del JWT de autenticacion.
JWT_SECRET_KEY=change-me-another-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Almacenamiento de videos y clips generados.
STORAGE_PATH=./data/storage

# Limite de subida en bytes (2 GB). Ajustable si se cambia el plan del MVP.
MAX_UPLOAD_BYTES=2147483648
