# Plantilla de variables de entorno del backend de ClipCatcher.
# Copia este archivo a `backend/.env` y rellena los valores reales.
# El archivo `.env` esta gitignorado: NUNCA subir secretos al repositorio.

# Clave general de la aplicacion (cookies firmadas, etc.). Cambiar siempre.
APP_SECRET_KEY=change-me-a-long-random-string

# Conexion a la base de datos. SQLite local para el MVP.
# La carpeta `data/` se crea automaticamente al arrancar.
DATABASE_URL=sqlite:///./data/clipcatcher.db

# Configuracion del JWT de autenticacion.
JWT_SECRET_KEY=change-me-another-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Almacenamiento de videos y clips generados.
STORAGE_PATH=./data/storage

# Limite de subida en bytes (10 GiB). Ajustable si se cambia el plan del MVP.
MAX_UPLOAD_BYTES=10737418240

# --- Google OAuth (opcional, F8) ---
# Si GOOGLE_CLIENT_ID esta vacio, el boton "Continuar con Google" del
# frontend se oculta y los endpoints /api/auth/google/* devuelven 503.
# Esto permite usar la app solo con email+password sin necesidad de
# tener credenciales de Google Cloud (importante para el evaluador).
# Para activarlo: crea un OAuth Client ID tipo "Web application" en
# https://console.cloud.google.com/apis/credentials y autoriza el
# redirect URI exacto que pongas en GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/auth/google/callback
FRONTEND_URL=http://127.0.0.1:8001
